# Zen Browser Profile Backup Exclusions
# Excludes transient caches, lock files, shaders, and temporary data
*/cache2/*
*/startupCache/*
*/Crash Reports/*
*/Pending Pings/*
*/jumpListCache/*
*/thumbnails/*
*/to-be-removed/*
*/temporary/*
*/parent.lock
*/lock
*/.parentlock
*/safebrowsing/*
*/shader-cache/*
*/storage/default/*/cache/*
*/storage/default/*/cache
*/gmp-widevinecdm/*
*/gmp-gmpopenh264/*
*/chrome_debugger_profile/*
*/datareporting/archived/*
*/sessionstore-backups/*
*/zen-sessions-backup/*

# Internal Chrome IndexedDB (Mozilla remote settings, offline translations, activity stream)
*/storage/permanent/chrome/idb/*
*/storage/permanent/chrome/idb

# Website icon caches (auto-regenerated on visit)
*/favicons.sqlite*

# Mozilla classification and certificate revocation caches (auto-updated)
*/domain_to_categories.sqlite*
*/security_state/*
*/security_state

# Crash logs and telemetry
*/crashes/*
*/minidumps/*
*/saved-telemetry-pings/*
